# Smart Skies environment template
#
# Copy this file to .env locally if you need runtime configuration.
# .env is ignored by git and must never be committed.

LLM_ENABLED=false
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
UAV_LLM_MODEL=llama3-70b-8192
GROQ_API_KEY=replace_me

# Strong non-default secret required for FAISS index signing/loading.
UAV_FAISS_SECRET=replace_with_strong_secret

# Optional canonical RAG path overrides used by config_v3.
UAV_RAG_BASE_DIR=src/uav_risk/stage2/knowledge
UAV_RAG_INDEX_DIR=src/uav_risk/stage2/knowledge/vectdb
UAV_RAG_DOCS_DIR=src/uav_risk/stage2/docs
UAV_RAG_MODELS_DIR=src/uav_risk/stage2/knowledge/models